generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Onibus {
  id                Int    @id @default(autoincrement())
  placa             String @unique
  identificacaoRFID String @unique
  modelo            String
  status            String
}

model Parada {
  id        Int    @id @default(autoincrement())
  nome      String
  latitude  Float
  longitude Float
}