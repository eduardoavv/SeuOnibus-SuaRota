generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Rota {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?

  onibus    Onibus[]
  paradas   Parada[]
}

model Onibus {
  id                Int    @id @default(autoincrement())
  placa             String @unique
  identificacaoRFID String @unique
  modelo            String
  status            String
  
  rotaId            Int?
  rota              Rota?  @relation(fields: [rotaId], references: [id], onDelete: SetNull)
}

model Parada {
  id        Int    @id @default(autoincrement())
  nome      String
  latitude  Float
  longitude Float

  rotaId    Int?
  rota      Rota?  @relation(fields: [rotaId], references: [id], onDelete: SetNull)
}