generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum StatusOnibus {
  ATIVO
  INATIVO
  MANUTENCAO
}

enum TipoUsuario {
  ALUNO
  RESPONSAVEL
  ADMIN
}
model Rota {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  onibus    Onibus[]
  paradas   Parada[]
  favoritas UsuarioFavoritaRota[] // Nova relação
}

model Onibus {
  id                Int           @id @default(autoincrement())
  placa             String        @unique
  identificacaoRFID String        @unique
  modelo            String
  status            StatusOnibus  @default(ATIVO) // Atualizado para Enum
  rotaId            Int?
  localizacoes      Localizacao[]
  rota              Rota?         @relation(fields: [rotaId], references: [id], onDelete: SetNull)
}

model Usuario {
  id        String    @id @default(uuid()) // Atualizado para UUID
  nome      String
  email     String    @unique
  senha     String
  tipo      TipoUsuario @default(ALUNO) // Atualizado para Enum
  rotasFavoritas UsuarioFavoritaRota[] // Nova relação
}


model Parada {
  id        Int    @id @default(autoincrement())
  nome      String
  latitude  Float
  longitude Float
  rotaId    Int?
  rota      Rota?  @relation(fields: [rotaId], references: [id])
}

model Localizacao {
  id           Int      @id @default(autoincrement())
  latitude     Float
  longitude    Float
  registradaEm DateTime @default(now())
  onibusId     Int
  onibus       Onibus   @relation(fields: [onibusId], references: [id], onDelete: Cascade)

  @@index([onibusId, registradaEm])
}

model UsuarioFavoritaRota {
  usuarioId      String
  rotaId         Int
  notificarAtraso Boolean  @default(true)
  criadoEm       DateTime @default(now())

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rota    Rota    @relation(fields: [rotaId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rotaId]) // Índice composto exigido na rubrica
}